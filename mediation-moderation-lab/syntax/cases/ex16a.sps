GET DATA /TYPE=TXT /FILE='data/ex16a.csv'
 /ENCODING='UTF8' /DELCASE=LINE /DELIMITERS=","
 /ARRANGEMENT=DELIMITED /FIRSTCASE=2
 /VARIABLES=x F16.8 w F16.8 y F16.8.
EXECUTE.
COMPUTE xw=x*w.
REGRESSION /STATISTICS COEFF R ANOVA CI(95)
 /DEPENDENT y /METHOD=ENTER x w xw.
INSERT FILE='C:/macros/process51.sps'.
PROCESS y=y /x=x /w=w /model=1 /jn=1 /conf=95.
