TITLE: PATIENT latent class analysis with grouped patterns;
DATA: FILE = patient-patterns.dat;
VARIABLE:
    NAMES = Y1-Y3 n;
    USEVARIABLES = Y1-Y3;
    CATEGORICAL = Y1-Y3;
    FREQWEIGHT = n;
    MISSING = ALL (-9);
    CLASSES = c(3);
ANALYSIS:
    TYPE = MIXTURE;
    STARTS = 1000 200;
    STITERATIONS = 20;
OUTPUT:
    TECH1 TECH8;
PLOT:
    TYPE = PLOT3;
    SERIES = Y1-Y3 (*);
